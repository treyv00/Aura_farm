
# Starting bank balance
balance = 0
account_active = True

# List of chores and the money earned for completing them
tasks = [
    ["Clean up room", 5],
    ["Fold clothes", 10],
    ["Wash dishes", 15],
    ["Take out trash", 10],
    ["Make bed", 5],
    ["Sweep floor", 10],
    ["Vacuum carpets", 15],
    ["Mow lawn", 20],
    ["Walk dog", 10],
    ["Feed pets", 5]
]

# Function to display the current bank balance
def check_balance():
    print("Your current balance is: $", balance)

# Function to display all available chores
def show_tasks():
    print("\nAvailable Tasks:")
    for number, task in enumerate(tasks, start=1):
        print(number, ":", task[0], "- Earn $", task[1])

# Main banking program
while account_active:
    print("\nWelcome to bank account")
    print("1. Check Balance")
    print("2. Withdraw Money")
    print("3. Exit")
    print("4. Tasks")

    user_choice = input("Please select an option (1-4): ")

    # Check account balance
    if user_choice == "1":
        check_balance()

    # Withdraw money from the account
    elif user_choice == "2":
        check_balance()
        withdraw_amount = int(input("Enter the amount to withdraw: "))

        if withdraw_amount <= 0:
            print("Please enter a positive amount.")

        elif withdraw_amount > balance:
            print("Insufficient funds. Your current balance is:", balance)

        else:
            balance -= withdraw_amount
            print("Withdrawal successful!")
            print("Your new balance is:", balance)

    # Exit the banking program
    elif user_choice == "3":
        print("Thank you for using the bank account!")
        account_active = False

    # Display tasks and earn money
    elif user_choice == "4":
        show_tasks()

        task_choice = input("Please select a task (1-10): ")

        if task_choice.isdigit():
            task_number = int(task_choice)

            if 1 <= task_number <= len(tasks):
                selected_task = tasks[task_number - 1]
                balance += selected_task[1]

                print("You completed:", selected_task[0])
                print("You earned: $", selected_task[1])
                print("Your new balance is: $", balance)

            else:
                print("Invalid task selection.")

        else:
            print("Please enter a number.")

    else:
        print("Invalid option. Please select 1-4.")
